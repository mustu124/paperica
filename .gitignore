# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only .env.example is committed)
.env*
.env.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand source documents (handover, reference layout, logo originals) are kept out of this
# public repo; the logo files the site uses live in public/brand
/brand/

# Original photo bank (1.8 GB of PNGs). Optimised copies are uploaded to Supabase Storage.
/PAPERICA IMAGE BANK/

# Image downloads from the client Drive (photos are uploaded to Supabase Storage, not kept in git)
/*-2026*T*Z-*/
# Loose images dropped in the project root (uploaded to Supabase Storage instead)
/*.png
/*.jpg
/*.jpeg
/*.webp
