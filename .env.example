# Technical secrets and URLs only.
# Business data (phone, WhatsApp, email, shipping fee, copy, images) lives in Supabase
# and is edited from /admin. Never add it here.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Razorpay key id (rzp_test_… / rzp_live_…). RAZORPAY_KEY_ID is optional: the server falls
# back to NEXT_PUBLIC_RAZORPAY_KEY_ID. If you set both, use the same value.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
